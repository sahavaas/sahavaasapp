# ==============================================================================
# Sahavaas Launch Environment Variables (Vercel Project Settings -> Env Vars)
# ==============================================================================

# 1. Supabase Project Credentials (Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Session & Security Secrets (Generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-64-char-random-hex-secret

# 3. Optional: Allowed CORS Origin in Production (e.g., https://sahavaas.vercel.app)
ALLOWED_ORIGIN=http://localhost:3000

# 4. Supabase Storage Bucket for UPI Payment Screenshots
PAYMENT_PROOFS_BUCKET=payment-proofs
